AWS_REGION=us-west-2
DYNAMO_TABLE_NAME=PortfolioData
PROFILE_PK="PROFILE#ethan-harter"

# Base model ID — us./eu./apac. prefix is added automatically from AWS_REGION
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1024

# Credentials: prefer `aws login` / `aws configure` (Lambda uses its IAM role).
# Static keys set here override your CLI login and fail once rotated; only
# uncomment if you have no other option.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
